+bool GSTextureReplacements::WaitForWorkerIdle(unsigned timeout_ms)
+{
+	const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+	for (;;)
+	{
+		{
+			std::unique_lock<std::mutex> lock(s_worker_thread_mutex);
+			if (!s_worker_thread.joinable() || s_worker_thread_queue.empty())
+				return true;
+		}
+		if (std::chrono::steady_clock::now() >= end)
+			return false;
+		std::this_thread::sleep_for(std::chrono::milliseconds(5));
+	}
+}
+
+unsigned GSTextureReplacements::PendingWorkerItems()
+{
+	std::unique_lock<std::mutex> lock(s_worker_thread_mutex);
+	return static_cast<unsigned>(s_worker_thread_queue.size());
