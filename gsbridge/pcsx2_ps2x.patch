+// ps2x: PS2XGS_UIVIDEO=<file.mp4> records the finished window picture (game + overlays) at 30 fps through ffmpeg
+#ifdef _WIN32
+#define popen _popen
+#define pclose _pclose
+#endif
+static void ps2xUiVideoFrame(const GSVector2i& size)
+{
+	static const char* ziel = [] { const char* e = std::getenv("PS2XGS_UIVIDEO"); return (e && *e) ? e : nullptr; }();
+	if (!ziel || size.x <= 0 || size.y <= 0) return;
+	static FILE* pipe = nullptr; static int w = 0, h = 0; static bool fehler = false; static unsigned zaehler = 0;
+	static std::vector<u8> puffer;
+	if (fehler || (zaehler++ & 1u)) return;
+	if (!pipe)
+	{
+		w = size.x & ~1; h = size.y & ~1;
+		const std::string cmd = fmt::format("ffmpeg -y -loglevel error -f rawvideo -pix_fmt rgba -s {}x{} -r 30 -i - -vf vflip,format=yuv420p -c:v libx264 -preset veryfast -crf 18 \"{}\"", w, h, ziel);
+		pipe = popen(cmd.c_str(), "w");
+		if (!pipe) { fehler = true; return; }
+		std::atexit([] { if (pipe) { pclose(pipe); pipe = nullptr; } });
+		puffer.resize(static_cast<size_t>(w) * h * 4);
+	}
+	if (size.x < w || size.y < h) return;
+	GLint altFb = 0, altPack = 4; glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &altFb); glGetIntegerv(GL_PACK_ALIGNMENT, &altPack);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+	glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	glReadPixels(0, size.y - h, w, h, GL_RGBA, GL_UNSIGNED_BYTE, puffer.data());
+	glPixelStorei(GL_PACK_ALIGNMENT, altPack); glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(altFb));
+	if (std::fwrite(puffer.data(), 1, puffer.size(), pipe) != puffer.size()) { fehler = true; pclose(pipe); pipe = nullptr; }
+}
